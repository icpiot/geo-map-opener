{
  "manifest_version": 3,
  "name": "Geo Map Opener",
  "version": "0.13",
  "description": "Right\u2011click geo tool (smart mode)",
  "icons": {
    "16": "Logo.png",
    "32": "Logo.png",
    "48": "Logo.png",
    "128": "Logo.png"
  },
  "permissions": [
    "tabs",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
