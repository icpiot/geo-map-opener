{
  "manifest_version": 3,
  "name": "Geo Map Opener",
  "version": "0.4",
  "description": "Right\u2011click geo tool (smart mode)",
  "permissions": [
    "tabs",
    "contextMenus"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
